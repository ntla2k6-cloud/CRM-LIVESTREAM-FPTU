{
  "manifest_version": 3,
  "name": "FPTU LIVE Capture",
  "version": "1.1.0",
  "description": "Bắt comment TikTok LIVE và đồng bộ realtime về CRM Tuyển sinh FPTU (lead, minigame, dashboard)",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://crm-livestream-fptu.onrender.com/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/@*/live*"],
      "js": ["content.js"]
    }
  ]
}
