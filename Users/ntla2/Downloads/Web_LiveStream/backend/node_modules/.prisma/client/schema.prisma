// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// AUTHENTICATION (NextAuth)
// -----------------------------------------------------------------------------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("GUEST")

  accounts Account[]
  sessions Session[]

  assignedLeads Lead[]        @relation("CskhLeads")
  leadHistories LeadHistory[] // Lịch sử chăm sóc do CSKH này tạo
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// STAFF & TEAM
// -----------------------------------------------------------------------------
model Staff {
  id       Int     @id @default(autoincrement())
  name     String
  role     String // MC / Host, CSKH, Kỹ thuật, Moderator...
  phone    String?
  email    String?
  rate     Int     @default(0) // Đơn giá / Ca (VND)
  avatar   String?
  color    String? // VD: bg-orange-500
  joinDate String?
  status   String  @default("Sẵn sàng") // Sẵn sàng, Đang nghỉ phép...

  assignments LiveSessionAssignment[]
}

// -----------------------------------------------------------------------------
// CAMPAIGN & LIVESESSION (Schedule + Live Pipeline)
// -----------------------------------------------------------------------------
model Campaign {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("PLANNING")
  budget    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions LiveSession[]
  leads    Lead[]
}

model LiveSession {
  id         String    @id @default(uuid())
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  // Thông tin lịch (tích hợp từ bảng Shift cũ)
  liveId      String?   @unique
  title       String
  description String?
  color       String?   @default("#F58220")
  project     String?   @default("Khác")
  day         Int?
  time        String?
  registered  String?
  scheduledAt DateTime? // Ngày giờ dự kiến diễn ra
  startTime   DateTime? // Giờ thực tế bắt đầu
  endTime     DateTime? // Giờ thực tế kết thúc
  status      String    @default("SCHEDULED") // SCHEDULED, LIVE_NOW, COMPLETED, CANCELLED

  createdAt DateTime @default(now())

  // Relations
  assignments LiveSessionAssignment[]
  script      Script?
  comments    LiveComment[]
  leads       Lead[]
  questions   Question[]
  winners     Winner[]
}

model LiveSessionAssignment {
  id            Int         @id @default(autoincrement())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  staffId       Int
  staff         Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)

  bonus        Int  @default(0) // Thưởng thêm cho ca này (VND)
  rateOverride Int? // Mức rate riêng biệt nếu có

  @@unique([liveSessionId, staffId])
}

model Script {
  id            Int         @id @default(autoincrement())
  liveSessionId String      @unique
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  content String? // Nội dung kịch bản (Text/HTML)

  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// TIKTOK COMMENT ENGINE & MINIGAME
// -----------------------------------------------------------------------------
model Customer {
  id              String  @id @default(uuid())
  fullName        String?
  phone           String?
  tiktokAccount   String? @unique
  highSchool      String?
  classGrade      String?
  location        String?
  interestedMajor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads    Lead[]
  comments LiveComment[]
  answers  Answer[]
  winners  Winner[]
}

model LiveComment {
  id            String      @id @default(uuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id])
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])

  tiktokUserId String?
  username     String
  content      String
  aiIntent     String? // Dùng để AI đánh dấu là "HOT LEAD", "QUESTION", v.v.

  // Dập timestamp chuẩn xác tại Server Queue để chống race condition
  serverTimestamp DateTime @default(now())

  answers Answer[]
}

model Question {
  id            String      @id @default(uuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id])

  code          String // VD: Q001, Q002
  content       String? // Nội dung câu hỏi
  correctAnswer String // VD: "A", "B", "1.A"
  timeLimit     Int     @default(30) // Thời gian trả lời (giây)

  status    String    @default("PENDING") // PENDING, ACTIVE, CLOSED
  startedAt DateTime?
  closedAt  DateTime?

  answers Answer[]
  winners Winner[]
}

model Answer {
  id         String      @id @default(uuid())
  questionId String
  question   Question    @relation(fields: [questionId], references: [id])
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  commentId  String
  comment    LiveComment @relation(fields: [commentId], references: [id])

  userAnswer String

  // Các trạng thái của một câu trả lời để loại trừ Duplicate, Sai
  status   String  @default("PENDING") // CORRECT, INCORRECT, DUPLICATE, INVALID
  isWinner Boolean @default(false)

  responseSpeed Int // Tính bằng mili-giây từ lúc Question ACTIVE
  createdAt     DateTime @default(now())
}

// -----------------------------------------------------------------------------
// FULFILLMENT: WINNER -> GIFT -> SHIPMENT -> TRACKING
// -----------------------------------------------------------------------------
model Gift {
  id     Int    @id @default(autoincrement())
  name   String
  sku    String @unique
  stock  Int    @default(0)
  price  String // VD: "350,000đ"
  status String // Sẵn sàng, Sắp hết, Hết hàng

  winners Winner[]
}

model Winner {
  id            String      @id @default(uuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id])
  questionId    String?
  question      Question?   @relation(fields: [questionId], references: [id])
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  giftId        Int
  gift          Gift        @relation(fields: [giftId], references: [id])

  // Trạng thái nhận quà
  status    String   @default("PENDING_INFO") // PENDING_INFO, INFO_RECEIVED, CONFIRMED
  createdAt DateTime @default(now())

  shipment Shipment?
}

model Shipment {
  id       String  @id // VD: "DON-001"
  winnerId String? @unique
  winner   Winner? @relation(fields: [winnerId], references: [id])

  recipientName String
  phone         String
  address       String

  // Trạng thái vận chuyển
  status String @default("PACKING") // PACKING, SHIPPED, DELIVERED, RETURNED

  shippingProvider String? // VD: GHTK, Viettel Post...
  trackingCode     String? // Mã vận đơn để khách tra cứu
  trackingLink     String? // Link theo dõi

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// CRM LEAD PIPELINE
// -----------------------------------------------------------------------------
model Lead {
  id            String       @id @default(uuid())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  campaignId    String?
  campaign      Campaign?    @relation(fields: [campaignId], references: [id])
  liveSessionId String?
  liveSession   LiveSession? @relation(fields: [liveSessionId], references: [id])

  assignedCskhId String?
  assignedCskh   User?   @relation("CskhLeads", fields: [assignedCskhId], references: [id])

  // CRM Pipeline Status
  status    String  @default("NEW") // NEW, CONTACTED, CONSULTING, REGISTERED, NOT_INTERESTED, UNREACHABLE
  source    String  @default("LIVESTREAM")
  leadScore Int     @default(0)
  intent    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  histories LeadHistory[]
}

model LeadHistory {
  id     String  @id @default(uuid())
  leadId String
  lead   Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  cskhId String?
  cskh   User?   @relation(fields: [cskhId], references: [id])

  action String // CALL, ZALO, SMS, NOTE, SYSTEM
  note   String? // Nội dung ghi chú chi tiết

  timestamp DateTime @default(now())
}
