generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// NEXTAUTH & USER (Auth & Internal Management)
// -----------------------------------------------------------------------------
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("GUEST") // ADMIN, MANAGER, CSKH, VJ_HOST, GUEST
  status        String    @default("ACTIVE")
  phone         String?
  department    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  leads         Lead[]
  followUps     FollowUp[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Staff {
  id          Int      @id @default(autoincrement())
  name        String
  role        String   // MC / Host, CSKH, Kỹ thuật, Moderator...
  phone       String?
  email       String?
  rate        Int      @default(0) // Đơn giá / Ca (VND)
  avatar      String?  
  color       String?  // VD: bg-orange-500
  joinDate    String?
  status      String   @default("Sẵn sàng") // Sẵn sàng, Đang nghỉ phép...
  
  assignments ShiftAssignment[]
}

// -----------------------------------------------------------------------------
// SCHEDULE & EDITORIAL (Lịch phân công & Kịch bản)
// -----------------------------------------------------------------------------
model Shift {
  id          Int      @id @default(autoincrement())
  day         Int      // Ngày trong tháng
  time        String   // VD: "19:00"
  title       String   // Tên chương trình LIVE
  type        String   // Tuyển sinh, Q&A, Tư vấn...
  color       String   // Màu sắc hiển thị
  
  assignments ShiftAssignment[]
  script      Script?
}

model ShiftAssignment {
  id          Int      @id @default(autoincrement())
  shiftId     Int
  shift       Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staffId     Int
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  bonus       Int      @default(0) // Thưởng thêm cho ca này (VND)
  rateOverride Int?    // Có thể lưu mức rate riêng nếu muốn (tùy chọn)

  @@unique([shiftId, staffId])
}

model Script {
  id          Int      @id @default(autoincrement())
  shiftId     Int      @unique
  shift       Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  
  content     String?  // Nội dung kịch bản (Text/HTML)
  questions   String?  // Danh sách câu hỏi định dạng JSON string (chờ xử lý dạng mảng)
  
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// INVENTORY & FULFILLMENT (Kho quà tặng)
// -----------------------------------------------------------------------------
model Gift {
  id          Int      @id @default(autoincrement())
  name        String
  sku         String   @unique
  stock       Int      @default(0)
  sent        Int      @default(0)
  price       String   // VD: "350,000đ"
  status      String   // Sẵn sàng, Sắp hết, Hết hàng
  
  orders      Order[]
}

model Order {
  id               String   @id // VD: "DON-001"
  recipient        String
  phone            String
  address          String
  giftId           Int
  gift             Gift     @relation(fields: [giftId], references: [id])
  qty              Int      @default(1)
  
  status           String   @default("Đã tiếp nhận") // Đã tiếp nhận, Đã xử lý, Đang vận chuyển, Đã giao
  date             String   // "14/09/2026 10:15"
  
  // Tracking fields
  shippingProvider String?  // VD: GHTK, Viettel Post...
  trackingCode     String?  // Mã vận đơn để khách tra cứu
  trackingLink     String?  // Link theo dõi
}

// -----------------------------------------------------------------------------
// CRM & MINIGAME (Kế thừa từ phiên bản trước)
// -----------------------------------------------------------------------------
model Campaign {
  id          String   @id @default(uuid())
  name        String
  status      String   @default("PLANNING")
  budget      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    LiveSession[]
  leads       Lead[]
}

model LiveSession {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  liveId      String?  @unique
  title       String
  startTime   DateTime?
  endTime     DateTime?
  status      String   @default("SCHEDULED")
  createdAt   DateTime @default(now())

  comments    LiveComment[]
  leads       Lead[]
  questions   Question[]
}

model Customer {
  id              String   @id @default(uuid())
  fullName        String?
  phone           String?
  tiktokAccount   String?  @unique
  highSchool      String?
  classGrade      String?
  location        String?
  interestedMajor String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leads           Lead[]
  comments        LiveComment[]
  answers         Answer[]
}

model Lead {
  id              String   @id @default(uuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id])
  liveSessionId   String?
  liveSession     LiveSession? @relation(fields: [liveSessionId], references: [id])
  assignedCskhId  String?
  assignedCskh    User?    @relation(fields: [assignedCskhId], references: [id])
  
  status          String   @default("NEW") // Thay Enum bằng String để dùng cho SQLite dễ dàng
  leadScore       Int      @default(0)
  intent          String?
  note            String?
  history         Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  followUps       FollowUp[]
}

model LiveComment {
  id            String   @id @default(uuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id])
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  
  tiktokUserId  String?
  username      String
  content       String
  aiIntent      String?
  
  timestamp     DateTime @default(now())

  answers       Answer[]
}

model Question {
  id            String   @id @default(uuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id])
  
  code          String   // VD: Q001, Q002
  content       String?  // Nội dung câu hỏi
  correctAnswer String   // VD: "A", "B", "1.A"
  
  status        String   @default("PENDING") // PENDING, ACTIVE, CLOSED
  startedAt     DateTime?
  closedAt      DateTime?
  
  answers       Answer[]
}

model Answer {
  id            String   @id @default(uuid())
  questionId    String
  question      Question @relation(fields: [questionId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  commentId     String
  comment       LiveComment @relation(fields: [commentId], references: [id])
  
  userAnswer    String
  isCorrect     Boolean
  responseSpeed Int      // Tính bằng mili-giây từ lúc Question ACTIVE
  
  createdAt     DateTime @default(now())
}

model FollowUp {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id])
  cskhId      String
  cskh        User     @relation(fields: [cskhId], references: [id])
  
  note        String?
  scheduledAt DateTime
  status      String   @default("PENDING")
  
  createdAt   DateTime @default(now())
}
